# Persistence
DATABASE_PATH=data/metrics.db

# Data-quality thresholds
NULL_RATE_THRESHOLD=0.08
DUPLICATE_RATE_THRESHOLD=0.04
ROW_DELTA_THRESHOLD=0.35
SLOW_RUN_SECONDS=120

# Optional. Leave empty for local/demo usage.
# Set a value in deployed environments and send it as the X-API-Key header.
INGESTION_API_KEY=
